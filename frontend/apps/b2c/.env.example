# Domaine commun : chaque client est aussi accessible via <slug>.<TENANT_BASE_DOMAIN>.
# En local, "localhost" permet de tester avec http://sej.localhost:3000
TENANT_BASE_DOMAIN=localhost

# URL de l'API .NET (appelée côté serveur uniquement).
API_URL=http://localhost:5063

# Pour travailler contre l'API Azure : copier ce fichier en .env.azure avec
# API_URL=https://<api-azure>, puis lancer npm run dev:azure.
