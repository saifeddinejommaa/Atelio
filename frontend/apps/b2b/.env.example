# Copier en .env.local pour le développement.

# URL de l'API .NET vers laquelle le serveur de dev relaie /api (voir vite.config.ts).
API_URL=http://localhost:5063

# URL de l'API vue par le navigateur. Vide : même origine (/api, relayé en dev).
VITE_API_URL=

# Domaine commun : chaque société est aussi accessible via <slug>.<domaine>.
# En local, "localhost" permet d'ouvrir http://gmg78.localhost:3002
VITE_BRAND_BASE_DOMAIN=localhost
