server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;

    # Relais de l'API (comme le proxy Vite en dev) : même origine, pas de CORS.
    location /api/ {
        proxy_pass ${API_URL};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Fichiers générés par Vite (nom avec empreinte) : cache long.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # index.html jamais en cache, pour que chaque déploiement soit pris en compte.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Routes de l'application (react-router) : toujours index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}